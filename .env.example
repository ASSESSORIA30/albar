# ─── URL pública del sitio (sin barra final). Obligatoria en producción para SEO, sitemap y canonical.
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.es

# ─── Envío de solicitudes por email (Resend · https://resend.com). Solo servidor: nunca con prefijo NEXT_PUBLIC.
RESEND_API_KEY=
LEAD_EMAIL_TO=          # buzón comercial que recibe las solicitudes (admite varios separados por coma)
LEAD_EMAIL_FROM=        # remitente verificado en Resend, p. ej. "Albar <solicitudes@tu-dominio.es>"

# ─── CRM (webhook genérico: HubSpot, Pipedrive vía Zapier/Make, n8n, etc.). Solo servidor.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=     # opcional: se envía como "Authorization: Bearer <secreto>"

# ─── Antispam opcional con Cloudflare Turnstile (si se rellenan ambas, el formulario lo exige).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── WhatsApp comercial en formato internacional sin "+" ni espacios, p. ej. 34600000000.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Analítica (solo se carga tras consentimiento expreso). ID de Google Analytics 4, p. ej. G-XXXXXXX.
NEXT_PUBLIC_GA4_ID=

# ─── Muestra /panel-datos en producción (en desarrollo siempre está visible). Recomendado: false.
ENABLE_CONFIG_PANEL=false
